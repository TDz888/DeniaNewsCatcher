# ============================================
# DISCORD BOT CONFIGURATION
# ============================================

# Token bot Discord (lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Channel IDs (bật Developer Mode trong Discord, chuột phải vào channel → Copy ID)
CHANNEL_NEWS_ID=123456789012345678
CHANNEL_PAPERS_ID=123456789012345678
CHANNEL_MODELS_ID=123456789012345678
CHANNEL_LOGS_ID=123456789012345678

# ============================================
# LLM CONFIGURATION (MISTRAL AI)
# ============================================

# API Key của Mistral AI (lấy từ console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Model sử dụng (mặc định: mistral-small-latest)
LLM_MODEL=mistral-small-latest

# ============================================
# DATABASE
# ============================================

# Đường dẫn file SQLite (trên Railway, mount volume tại /data)
DB_PATH=/data/denia.db

# ============================================
# LOGGING
# ============================================

# Mức độ log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# FILTERS
# ============================================

# Điểm tối thiểu của bài viết trên Hacker News để được xử lý
HN_MIN_SCORE=150

# Số comment tối thiểu để bot fetch thảo luận cộng đồng
HN_MIN_COMMENTS=20

# Số bài viết tối đa lấy từ mỗi nguồn trong một chu kỳ
MAX_ARTICLES_PER_SOURCE=3

# ============================================
# LLM RATE LIMITING (QUAN TRỌNG)
# ============================================

# Khoảng cách tối thiểu giữa các request LLM (giây)
# Đặt 60 để đảm bảo an toàn với giới hạn 1 request/phút của Mistral free tier
LLM_RATE_INTERVAL=60

# Số lần thử lại tối đa khi gặp lỗi 429
LLM_MAX_RETRIES=3

# Thời gian timeout cho mỗi request LLM (giây)
LLM_TIMEOUT=120

# Số token tối đa cho mỗi lần tóm tắt
LLM_MAX_TOKENS=1500

# ============================================
# DISCORD CONFIGURATION
# ============================================

# Token bot Discord (lấy từ Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=your_bot_token_here

# User ID của chủ nhân Lux Cipher
# Bật Developer Mode trong Discord → chuột phải avatar → Copy User ID
DISCORD_OWNER_ID=123456789012345678

# ============================================
# LLM CONFIGURATION (MISTRAL AI)
# ============================================

# API key Mistral (lấy từ console.mistral.ai → API Keys)
MISTRAL_API_KEY=your_mistral_api_key_here

# Model sử dụng
LLM_MODEL=mistral-small-latest

# ============================================
# DATABASE
# ============================================

# Đường dẫn file SQLite
# Trên Railway: mount volume tại /data
# Local: ./data/denia.db
DB_PATH=/data/denia.db

# ============================================
# LOGGING
# ============================================

# Mức độ log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# LLM BEHAVIOR
# ============================================

# Khoảng cách tối thiểu giữa các lần gọi LLM (giây)
# Mistral free tier: 2 RPM → đặt 30 để an toàn
# Trả phí: có thể giảm xuống 5-10
LLM_RATE_INTERVAL=30

# Timeout mỗi request LLM (giây)
LLM_TIMEOUT=90

# Số token tối đa cho mỗi reply
LLM_MAX_TOKENS=1024

# Độ sáng tạo (0.0 - 1.0)
# 0.7-0.9: tự nhiên, có cá tính
# 0.5-0.7: ổn định, ít bất ngờ
LLM_TEMPERATURE=0.85

# ============================================
# CHAT BEHAVIOR
# ============================================

# Số message gần nhất dùng làm context
HISTORY_LIMIT=12

# Cooldown giữa các tin nhắn của cùng 1 user (giây)
USER_COOLDOWN=25

# Độ dài tối đa 1 tin Discord (Discord limit: 2000)
# Để 1900 để có buffer cho format
MAX_RESPONSE_LEN=1900
